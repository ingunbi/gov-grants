# 복사해서 .env로 저장한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 기업마당 API 인증키: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi → 'API 사용 신청'
BIZINFO_API_KEY=

# Claude API 키 (없으면 요약 단계만 건너뛰고 나머지는 그대로 동작)
ANTHROPIC_API_KEY=

# 배포 주소 (예: https://<계정>.github.io/<저장소>)
SITE_BASE_URL=

# 선택: 요약 모델/한도 덮어쓰기
# LLM_MODEL=claude-haiku-5-5
# LLM_MAX_PER_RUN=50

# 선택: 애드센스 (승인 후)
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT=0000000000
