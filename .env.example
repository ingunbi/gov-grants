# 복사해서 .env로 저장한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 기업마당 API 인증키: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi → 'API 사용 신청'
BIZINFO_API_KEY=

# 선택: 배포 주소를 잠깐 바꿔 빌드할 때만 (기본값은 site.config.json의 base_url)
SITE_BASE_URL=

# 선택: 한 번에 요약 대기열에 넣을 건수 (기본 50)
# SUMMARY_LIMIT=50

# 선택: 애드센스 (승인 후)
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT=0000000000

# 요약은 Claude 구독(Claude Code)으로 합니다. 로컬에서는 claude에 로그인된 상태면 되고,
# GitHub Actions에서는 CLAUDE_CODE_OAUTH_TOKEN 시크릿을 씁니다.
