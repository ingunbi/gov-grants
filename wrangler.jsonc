// Cloudflare Workers 정적 사이트 설정 (Workers 기반 Pages)
// 배포: npx wrangler deploy  → https://gov-grants.<계정 서브도메인>.workers.dev
{
  "name": "gov-grants",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
